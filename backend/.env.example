PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=onbillboard
JWT_SECRET=change_this_secret_in_production

# --- Admin notifications (order / internship / course / contact) ---
# Multiple recipients: separate with a comma. E.g. ADMIN_WHATSAPP=+250794109388,+250788123456
# and ADMIN_EMAIL=a@gmail.com,b@gmail.com
ADMIN_EMAIL=reponseimanirabizi@gmail.com
ADMIN_WHATSAPP=+250794109388
SITE_URL=http://localhost:5000

# Email (SMTP) - e.g. Gmail with an app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password

# WhatsApp - Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_ID=your-whatsapp-phone-number-id
WHATSAPP_API_VERSION=v19.0

# SMS - Africa's Talking (admin + customer notifications)
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
AT_SENDER_ID=your-approved-sender-id
AT_SANDBOX=true

# Mobile Money - Paypack (https://payments.paypack.rw)
# Create an application in your Paypack dashboard to get client_id / client_secret.
PAYPACK_CLIENT_ID=your-paypack-client-id
PAYPACK_CLIENT_SECRET=your-paypack-client-secret
# Webhook mode: development (sandbox) or production. Match the mode of your webhook.
PAYPACK_MODE=development
# Webhook secret used to verify x-paypack-signature (from Paypack dashboard webhook config).
PAYPACK_WEBHOOK_SECRET=your-paypack-webhook-secret
# Override only if needed (sandbox: https://sandbox-api.paypack.rw/api, live: https://payments.paypack.rw/api)
PAYPACK_BASE_URL=https://payments.paypack.rw/api
